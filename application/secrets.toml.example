# Copy this file to  secrets.toml  (same folder) and fill it in. NEVER share or upload secrets.toml.
#
# Gmail example (you need 2-Step Verification on, then create an "App password" at
# https://myaccount.google.com/apppasswords and paste the 16 characters below, not your normal password):
[email]
host = "smtp.gmail.com"
port = 587
security = "starttls"
username = "your.sender.address@gmail.com"
password = "xxxx xxxx xxxx xxxx"
sender = "your.sender.address@gmail.com"
