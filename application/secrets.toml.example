# From the repository root, copy this template to application/.streamlit/secrets.toml and fill it in.
# Never share or commit the real secrets.toml file.
#
# Gmail example (you need 2-Step Verification on, then create an "App password" at
# https://myaccount.google.com/apppasswords and paste the 16 characters below, not your normal password):
[email]
host = "smtp.gmail.com"
port = 587
security = "starttls"
username = "your.sender.address@gmail.com"
password = "xxxx xxxx xxxx xxxx"
sender = "your.sender.address@gmail.com"

# Optional OpenAI-generated guidance. API key use is opt-in within the app.
# API access may incur separate charges from ChatGPT.
[openai]
api_key = "your-openai-api-key"
model = "gpt-6-luna"
